# --- Python virtual environment -------------------------------------------
# The venv is rebuilt from requirements.txt, so it never belongs in the repo.
.venv/

# --- Python byte code ------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Project specific ------------------------------------------------------
# Trained models are build artefacts: they are regenerated by
# scripts/train_intent.py and would otherwise bloat the repository.
models/*.joblib

# Keep the folder itself in git even when it holds no tracked files.
!models/.gitkeep

# The raw GeoNames country dump (52 912 rows, ~1.5 MB zipped). It is an input,
# not a result: scripts/build_places.py re-downloads it on demand and writes
# the compact data/places_at.csv, which IS tracked so the bot runs from the
# submitted files without a download.
data/geonames_raw/

# pytest cache
.pytest_cache/

# Transcripts sent in by user-test participants. These are other people's
# conversations: they are working material for the evaluation, not part of the
# project, and they do not belong in a repository that gets submitted.
# scripts/analyze_transcripts.py reads this folder.
data/user_tests/*
!data/user_tests/README.md
